    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf lib lib-es",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.json -m esnext --moduleResolution bundler --outDir lib-es",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/New_York jest --passWithNoTests",
    "coverage": "TZ=America/New_York jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@ledgerhq/logs": "workspace:*",
    "axios": "catalog:",
    "eip55": "^2.1.1"
  },
