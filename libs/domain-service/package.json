{
  "name": "@ledgerhq/domain-service",
  "description": "Ledger service responsible for domain handling",
  "version": "1.9.1",
  "license": "Apache-2.0",
  "homepage": "https://github.com/LedgerHQ/ts-libs/tree/main/libs/domain-service",
  "bugs": {
    "url": "https://github.com/LedgerHQ/ts-libs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ts-libs.git"
  },
  "files": [
    "lib",
    "lib-es",
    "src",
    "CHANGELOG.md"
  ],
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib-es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./index": {
      "import": "./lib-es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./errors": {
