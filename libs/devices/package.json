{
  "name": "@ledgerhq/devices",
  "version": "8.18.0",
  "description": "Ledger devices",
  "keywords": [
    "Ledger"
  ],
  "homepage": "https://github.com/LedgerHQ/ts-libs/tree/main/libs/devices",
  "bugs": {
    "url": "https://github.com/LedgerHQ/ts-libs/issues"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "lib-es",
    "src",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ts-libs.git"
  },
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "typesVersions": {
    "*": {
      "helpers": [
        "lib/helpers.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "@ledgerhq/source": "./src/index.ts",
      "import": "./lib-es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./helpers": {
      "@ledgerhq/source": "./src/helpers.ts",
      "import": "./lib-es/helpers.js",
      "require": "./lib/helpers.js",
      "default": "./lib/helpers.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf lib lib-es",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.json -m esnext --moduleResolution bundler --outDir lib-es",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "semver": "catalog:"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "jest": "catalog:",
    "jest-sonar": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
