{
  "name": "@ledgerhq/psbtv2",
  "version": "0.5.0",
  "description": "Partially Signed Bitcoin Transaction version 2 (BIP370) implementation",
  "keywords": [
    "Ledger",
    "Bitcoin",
    "PSBT",
    "BIP370",
    "BIP174"
  ],
  "homepage": "https://github.com/LedgerHQ/ts-libs/tree/main/libs/psbtv2",
  "bugs": {
    "url": "https://github.com/LedgerHQ/ts-libs/issues"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "lib-es",
    "src",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ts-libs.git"
  },
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "@ledgerhq/source": "./src/index.ts",
      "import": "./lib-es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf lib lib-es",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.json -m esnext --moduleResolution bundler --outDir lib-es",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "bitcoinjs-lib": "^6.1.7",
    "varuint-bitcoin": "1.1.2"
  },
  "devDependencies": {
    "@bitcoinerlab/secp256k1": "1.2.0",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "ecpair": "3.0.1",
    "jest": "catalog:",
    "jest-sonar": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
