{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "libs/*": {
      "project": ["src/**/*.ts"]
    },
    "libs/hw-transport": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["events"]
    },
    "libs/hw-transport-mocker": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["events"]
    }
  },
  "rules": {
    "binaries": "off",
    "dependencies": "error",
    "devDependencies": "off",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "optionalPeerDependencies": "off",
    "types": "warn",
    "unlisted": "off",
    "unresolved": "off"
  },
  "ignoreExportsUsedInFile": true
}
